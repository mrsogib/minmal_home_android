<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Theme"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Switch
            android:id="@+id/darkThemeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dark theme" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom colors (optional, overrides theme; leave blank to use theme default). Format: #RRGGBB" />

        <EditText
            android:id="@+id/customBgColorInput"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:hint="Background hex, e.g. #101010"
            android:inputType="text" />

        <EditText
            android:id="@+id/customTextColorInput"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:hint="Text hex, e.g. #EEEEEE"
            android:inputType="text" />

        <Button
            android:id="@+id/applyColorsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply colors" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text sizes &amp; spacing"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clock size (0.5 - 2.0, default 1.0)" />
        <EditText
            android:id="@+id/clockScaleInput"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="List row text size (sp, default 22)" />
        <EditText
            android:id="@+id/rowTextSizeInput"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="List row padding (dp, default 14)" />
        <EditText
            android:id="@+id/rowPaddingInput"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alphabet strip text size (sp, default 32)" />
        <EditText
            android:id="@+id/alphabetTextSizeInput"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/applySizesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply sizes" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gesture sensitivity"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swipe distance to trigger (dp, default 120 — lower = more sensitive)" />
        <EditText
            android:id="@+id/swipeThresholdInput"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Double-tap window (ms, default 300 — higher = more forgiving)" />
        <EditText
            android:id="@+id/doubleTapWindowInput"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <Button
            android:id="@+id/applyGesturesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply gesture settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clock style"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Spinner
            android:id="@+id/clockStyleSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Font"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Spinner
            android:id="@+id/fontSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wallpaper folder"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/pickWallpaperFolderButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose folder for random wallpaper" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rotation interval"
            android:layout_marginTop="8dp" />
        <Spinner
            android:id="@+id/wallpaperIntervalSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/changeWallpaperNowButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change wallpaper now" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Double-tap to lock screen"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Requires granting this app device-admin access, used only to lock the screen. No data is read or sent." />

        <Switch
            android:id="@+id/lockToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swipe gestures"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/swipeLeftButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose swipe-left apps" />

        <Button
            android:id="@+id/swipeRightButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose swipe-right apps" />

        <Button
            android:id="@+id/swipeUpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose swipe-up apps" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Widget tap targets"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/clockTapButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose app for clock tap" />

        <Button
            android:id="@+id/calendarTapButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose app for calendar tap" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Groups"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/manageGroupsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage groups" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App icons"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Switch
            android:id="@+id/showIconsSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show app icons (off = text only, lightest option)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accent color"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Switch
            android:id="@+id/dynamicAccentSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use accent color from current wallpaper" />

        <Button
            android:id="@+id/refreshAccentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh accent from wallpaper now" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notification preview on favorites"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This requires granting Notification Access, a sensitive system permission that lets this app read the content of your notifications from every app. It is off by default and only affects apps you've marked as favorites." />

        <Switch
            android:id="@+id/notificationPreviewSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show notification previews under favorites" />

        <Button
            android:id="@+id/openNotificationAccessButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open notification access settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions this app uses"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/permissionsExplainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
